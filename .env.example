# 데이터 소스 모드: live | demo
#  live : 로컬 크롤러 API 사용 → 국민대학교 실제 공지 (기본값)
#  demo : sampleNotices 사용 → Score/D-Day/챗봇/캐러셀 데모에 안정적인 데이터
VITE_DATA_MODE=live

# 로컬 크롤러 API 주소 (기본: http://127.0.0.1:8000/api/notices)
VITE_CRAWLER_API=http://127.0.0.1:8000/api/notices

# Supabase 연결 정보 (실제 값은 .env에 넣고 커밋하지 않는다)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 데모용 고정 사용자 id (회원가입/로그인 미구현)
VITE_DEMO_USER_ID=demo-user
