PORT=8001
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kmu_academic_profiles_v1
QDRANT_TIMEOUT_MS=5000
QDRANT_ALLOW_INSECURE_HTTP=false
# Optional development frontend origins, comma separated. file:// is not allowed.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# CHATBOT: generic JSON adapter endpoints (see CHATBOT/README.md).
# Blank endpoints mean NOT configured; no fake vectors/answers are generated.
CHATBOT_COLLECTION=kmu_notice_chunks_v1
CHATBOT_RAW_COLLECTION=kmu_notices_raw_v1
CHATBOT_TOP_K=10
CHATBOT_VECTOR_NAME=
CHATBOT_SCORE_THRESHOLD=
CHATBOT_MAX_CONTEXT_CHARS=12000
CHATBOT_MAX_OUTPUT_TOKENS=800
CHATBOT_TIMEOUT_MS=30000
CHATBOT_REQUEST_TIMEOUT_MS=18000
CHATBOT_EMBEDDING_URL=
CHATBOT_EMBEDDING_MODEL=
CHATBOT_EMBEDDING_SPACE=
CHATBOT_EMBEDDING_API_KEY=
CHATBOT_LLM_URL=
CHATBOT_LLM_MODEL=
CHATBOT_LLM_API_KEY=
