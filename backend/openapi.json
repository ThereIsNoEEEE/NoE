{
  "openapi": "3.1.0",
  "info": {
    "title": "KMU Pick 로컬 백엔드",
    "version": "0.1.0",
    "description": "학사 정보는 Qdrant payload-only 컬렉션에 저장합니다. 로컬 개발 전용이며 사용자 인증은 아직 없습니다. 제공 HTML의 시작하기 버튼은 아직 이 API를 호출하지 않습니다."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8001"
    }
  ],
  "paths": {
    "/api/chatbot": {
      "post": {
        "summary": "공지 벡터 TOP-K 검색 후 답변 또는 LLM 문맥 준비",
        "operationId": "queryChatbot",
        "description": "기본 TOP-K는 10입니다. prepare도 임베딩 API와 검색용 벡터 색인이 필요합니다. 학사 프로필은 검색하거나 모델에 전달하지 않습니다.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object", "additionalProperties": false, "required": ["prompt"],
            "properties": {
              "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
              "topK": { "type": "integer", "minimum": 1, "maximum": 20, "description": "생략하면 서버 설정값 사용 (기본 10)" },
              "mode": { "type": "string", "enum": ["answer", "prepare"], "default": "answer" }
            }
          } } }
        },
        "responses": {
          "200": { "description": "답변 완료, 문맥 준비 또는 검색 결과 없음", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatbotResponse" } } } },
          "400": { "description": "잘못된 JSON" },
          "403": { "description": "허용되지 않은 Host 또는 Origin" },
          "413": { "description": "본문 32KB 초과" },
          "415": { "description": "application/json 필요" },
          "422": { "description": "질문/옵션 검증 실패" },
          "502": { "description": "검색 또는 모델 응답 오류" },
          "503": { "description": "모델 미등록, 검색 색인 미생성/불일치 또는 DB 장애" },
          "504": { "description": "전체 요청 또는 모델 응답 제한 시간 초과" }
        }
      }
    },
    "/api/chatbot/status": {
      "get": {
        "summary": "챗봇 모델 설정 여부 (DB 연결/색인 준비 완료를 보장하지 않음)",
        "operationId": "getChatbotStatus",
        "responses": { "200": { "description": "URL과 키를 제외한 설정 상태", "content": { "application/json": { "schema": {
          "type": "object", "required": ["embeddingConfigured", "llmConfigured", "defaultTopK", "modes", "indexReadiness"],
          "properties": {
            "embeddingConfigured": { "type": "boolean" }, "llmConfigured": { "type": "boolean" },
            "defaultTopK": { "type": "integer", "minimum": 1, "maximum": 20 },
            "modes": { "type": "array", "items": { "type": "string", "enum": ["prepare", "answer"] } },
            "indexReadiness": { "type": "string", "const": "not_checked" }
          }
        } } } } }
      }
    },
    "/api/db/profiles": {
      "post": {
        "summary": "최초 학사 정보 저장",
        "operationId": "createAcademicProfile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcademicProfile"
              },
              "example": {
                "studentType": "대학원",
                "college": "소프트웨어융합대학원",
                "major": "AI",
                "grade": 1,
                "interests": [
                  "취업",
                  "인턴",
                  "AI/데이터",
                  "공모전"
                ],
                "customInterests": [],
                "keywords": [
                  "AI",
                  "데이터",
                  "해커톤"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "저장 완료. 반환된 id를 보관하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredProfile"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "허용되지 않은 Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "32KB 초과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON 형식 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "입력 검증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Qdrant 연결/저장 실패 또는 컬렉션 스키마 불일치",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/db/profiles/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "학사 정보 조회",
        "operationId": "getAcademicProfile",
        "responses": {
          "200": {
            "description": "저장한 학사 정보",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredProfile"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 UUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "프로필 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "DB 연결 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "학사 정보 전체 교체",
        "description": "누락한 선택 배열은 빈 배열로 교체됩니다. 동시 수정은 마지막 완료 요청이 우선합니다.",
        "operationId": "updateAcademicProfile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcademicProfile"
              },
              "example": {
                "studentType": "대학원",
                "college": "소프트웨어융합대학원",
                "major": "AI",
                "grade": 1,
                "interests": [
                  "취업",
                  "인턴",
                  "AI/데이터",
                  "공모전"
                ],
                "customInterests": [],
                "keywords": [
                  "AI",
                  "데이터",
                  "해커톤"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 완료",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredProfile"
                }
              }
            }
          },
          "400": {
            "description": "JSON/UUID 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "프로필 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "입력 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "DB 저장 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/db/health": {
      "get": {
        "summary": "Qdrant 연결 확인 (쓰기 없음)",
        "responses": {
          "200": {
            "description": "연결 성공. collectionExists는 최초 저장 전 false일 수 있습니다."
          },
          "503": {
            "description": "연결 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "백엔드 실행 상태",
        "responses": {
          "200": {
            "description": "정상 실행. DB 상태와 별개입니다."
          }
        }
      }
    },
    "/api/notices": {
      "get": {
        "summary": "실제 수집 공지 조회",
        "responses": {
          "200": {
            "description": "items, total, mode, sources, fetchedAt"
          },
          "502": {
            "description": "모든 출처 수집 실패. 샘플 대체 없음."
          }
        }
      }
    },
    "/api/crawl": {
      "post": {
        "summary": "공지 목록 재수집 (최소 30초 간격)",
        "responses": {
          "200": {
            "description": "수집 결과"
          },
          "502": {
            "description": "모든 출처 수집 실패"
          }
        }
      }
    },
    "/api/images/{id}": {
      "get": {
        "summary": "첫 본문/첨부 이미지",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{16}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PNG/JPEG/GIF/WebP 이미지"
          },
          "404": {
            "description": "수집 이미지 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "원본 이미지 응답 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatbotResponse": {
        "type": "object", "required": ["status", "answer", "sources", "topK", "retrievedCount", "contextCount"],
        "properties": {
          "status": { "type": "string", "enum": ["answered", "prepared", "no_results"] },
          "answer": { "type": ["string", "null"], "description": "prepared일 때 null" },
          "topK": { "type": "integer", "minimum": 1, "maximum": 20 },
          "retrievedCount": { "type": "integer", "minimum": 0, "maximum": 20 },
          "contextCount": { "type": "integer", "minimum": 0, "maximum": 20 },
          "sources": { "type": "array", "maxItems": 20, "items": { "$ref": "#/components/schemas/ChatbotSource" } },
          "messages": { "type": "array", "description": "prepared 응답에만 포함", "items": {
            "type": "object", "required": ["role", "content"],
            "properties": { "role": { "type": "string", "enum": ["system", "user"] }, "content": { "type": "string" } }
          } }
        }
      },
      "ChatbotSource": {
        "type": "object", "required": ["reference", "id", "noticeId", "rawPointId", "sourceContentHash", "score", "title", "content", "url", "date", "contentStatus", "needsOcr", "needsAttachmentExtraction", "reviewRequired"],
        "properties": {
          "reference": { "type": "string", "pattern": "^S[1-9][0-9]*$" },
          "id": { "type": "string" }, "noticeId": { "type": "string" }, "rawPointId": { "type": "string" },
          "sourceContentHash": { "type": "string" }, "score": { "type": "number" }, "title": { "type": "string" },
          "content": { "type": "string", "description": "실제로 모델에 전달한 범위의 공지 텍스트" },
          "url": { "type": ["string", "null"] }, "date": { "type": ["string", "null"] },
          "contentStatus": { "type": "string" }, "needsOcr": { "type": "boolean" },
          "needsAttachmentExtraction": { "type": "boolean" }, "reviewRequired": { "type": "boolean" }
        }
      },
      "AcademicProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "studentType",
          "college",
          "major",
          "grade",
          "interests"
        ],
        "properties": {
          "studentType": {
            "type": "string",
            "enum": [
              "학부",
              "대학원"
            ]
          },
          "college": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "major": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "학부 1~4, 대학원 1~3"
          },
          "interests": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          },
          "customInterests": {
            "type": "array",
            "maxItems": 20,
            "default": [],
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          },
          "keywords": {
            "type": "array",
            "maxItems": 20,
            "default": [],
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "studentType": {
                  "const": "대학원"
                }
              }
            },
            "then": {
              "properties": {
                "grade": {
                  "maximum": 3
                }
              }
            }
          }
        ]
      },
      "StoredProfile": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "schemaVersion",
          "profile",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "const": "academic_profile"
          },
          "schemaVersion": {
            "const": 1
          },
          "profile": {
            "$ref": "#/components/schemas/AcademicProfile"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
